# Match Microscope — environment variables
#
# Copy to `.env` in the repo root, then fill in what you need:
#     Copy-Item .env.example .env     # Windows PowerShell
#     cp .env.example .env            # macOS / Linux
#
# The pipeline loads `.env` at startup and never overrides shell variables.
# `.env` is git-ignored — never commit real secrets.

# --- Optional: Microsoft Agent Framework crew for `explain` ----------------
# Off unless you pass `--use-llm`:
#     python pipeline/run_pipeline.py --match syn-001 --use-llm
# Requires the agent deps and one backend below, and turns `explain` into a
# Narrator -> Verifier -> Director collaboration. Without it the pipeline
# stays fully offline on the built-in i18n templates (no network calls).
#     pip install -r pipeline/requirements-agents.txt
#     python pipeline/check_agents.py      # verify the connection

# Primary backend: Microsoft Foundry / Azure OpenAI.
# AZURE_OPENAI_CHAT_MODEL is your *deployment name*.
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_MODEL=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21

# Fallback backend: any OpenAI-compatible endpoint (used when the endpoint
# above is unset).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# --- Build-time only (set by the GitHub Pages workflow, not secrets) -------
# GITHUB_PAGES=true
# NEXT_BASE_PATH=/match-microscope
